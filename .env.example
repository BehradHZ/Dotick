# Developer-local only. Generate a fresh secret; never commit .env.
DOTICK_ENV=local
DOTICK_FOUNDATION_ENABLED=1
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_JWT_SIGNING_KEY=
GOOGLE_OAUTH_CLIENT_ID=
# Public OAuth client identifier bundled into the web client; never put a secret here.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Local WebAuthn defaults. Non-local environments require explicit HTTPS RP settings.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Dotick
WEBAUTHN_ORIGIN=http://localhost:8081
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
DJANGO_CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
# Secret: inject through deployment secret storage; never expose through EXPO_PUBLIC_*.
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=0
DJANGO_EMAIL_USE_SSL=0
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost
# Dotted import path. The default deliberately reports phone delivery unavailable.
DOTICK_SMS_DELIVERY_ADAPTER=dotick.identity.sms.UnavailableSmsDeliveryAdapter
# Deployment-edge policy inputs; Django does not enforce these limits in-process.
DOTICK_EDGE_IDENTITY_CEREMONY_BURST_REQUESTS=10
DOTICK_EDGE_IDENTITY_CEREMONY_BURST_WINDOW_SECONDS=60
DOTICK_EDGE_IDENTITY_CEREMONY_SUSTAINED_REQUESTS=100
DOTICK_EDGE_IDENTITY_CEREMONY_SUSTAINED_WINDOW_SECONDS=3600
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=dotick_dev
PGUSER=dotick
PGPASSWORD=
DOTICK_DEVELOPMENT_PASSWORD=
