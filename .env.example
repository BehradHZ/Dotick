# Developer-local only. Generate a fresh secret; never commit .env.
DOTICK_ENV=local
DOTICK_FOUNDATION_ENABLED=1
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_JWT_SIGNING_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@dotick.local
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
GOOGLE_OAUTH_CLIENT_ID=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Dotick
WEBAUTHN_ORIGINS=http://localhost:8081
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=dotick_dev
PGUSER=dotick
PGPASSWORD=
