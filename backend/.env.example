# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit real secrets.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Comma-separated. Add your laptop's LAN IP here so the phone browser
# can reach the backend, e.g.: localhost,127.0.0.1,192.168.1.23
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (ROADMAP.md §3)
DOTICK_DB_NAME=dotick
DOTICK_DB_USER=dotick
DOTICK_DB_PASSWORD=dotick
DOTICK_DB_HOST=localhost
DOTICK_DB_PORT=5432
