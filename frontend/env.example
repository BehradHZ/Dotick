# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit real secrets.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Comma-separated. Add your laptop's LAN IP here so the phone browser
# can reach the backend, e.g.: localhost,127.0.0.1,192.168.1.23
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (scheme + host + port, no trailing slash) the
# frontend is served from — this is what the browser sends as the
# `Origin` header on every fetch() from the app. local.py already
# defaults to Expo web's common ports (8081, 19006) on localhost, so
# you only need to set this explicitly when testing from a phone on
# the LAN: use the laptop's LAN IP with the frontend's port, e.g.
# http://192.168.1.23:8081
# DJANGO_CORS_ALLOWED_ORIGINS=http://192.168.1.23:8081

# PostgreSQL (ROADMAP.md §3)
DOTICK_DB_NAME=dotick
DOTICK_DB_USER=dotick
DOTICK_DB_PASSWORD=dotick
DOTICK_DB_HOST=localhost
DOTICK_DB_PORT=5432
