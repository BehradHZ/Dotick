# Copy this file to .env and fill in the value for your machine.
# .env is gitignored — never commit real values.

# Base URL of the Django backend (see ../backend/README.md).
#
# - Web (laptop browser): http://localhost:8000 works fine.
# - Phone browser on the same network: you MUST use your laptop's LAN IP
#   here instead of localhost, e.g. http://192.168.1.23:8000
#   (find it with `ipconfig getifaddr en0` on macOS, or `hostname -I` on
#   Linux) — and make sure that same IP is in the backend's
#   DJANGO_ALLOWED_HOSTS (see ../backend/.env.example).
#
# Must be prefixed with EXPO_PUBLIC_ to be readable in client code
# (Expo only exposes env vars with this prefix to the app bundle).
EXPO_PUBLIC_API_URL=http://localhost:8000
